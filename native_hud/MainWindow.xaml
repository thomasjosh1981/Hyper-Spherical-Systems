<Window x:Class="HypeSTokenHUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HypeSTokenHUD"
        mc:Ignorable="d"
        Title="👑 Hyper-Spherical Gold Token HUD"
        Height="740" Width="580"
        MinHeight="550" MinWidth="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <!-- Gold Gradient Brush -->
        <LinearGradientBrush x:Key="GoldBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFE066" Offset="0.0"/>
            <GradientStop Color="#D4AF37" Offset="0.35"/>
            <GradientStop Color="#8C6D1F" Offset="0.7"/>
            <GradientStop Color="#FFD700" Offset="1.0"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="GoldBannerBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#1A1506" Offset="0.0"/>
            <GradientStop Color="#292008" Offset="0.5"/>
            <GradientStop Color="#110E04" Offset="1.0"/>
        </LinearGradientBrush>

        <!-- Custom ScrollBar Style for DataGrid -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#03060C"/>
            <Setter Property="Width" Value="6"/>
        </Style>
    </Window.Resources>

    <Border Margin="4"
            CornerRadius="12"
            BorderThickness="3"
            BorderBrush="{StaticResource GoldBorderBrush}"
            Background="#050811">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="6" Opacity="0.85"/>
        </Border.Effect>

        <Grid Margin="12,10,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- 0: Header Drag Bar -->
                <RowDefinition Height="Auto"/> <!-- 1: Scrolling Ticker Marquee -->
                <RowDefinition Height="Auto"/> <!-- 2: 3 Digital LCD Windows -->
                <RowDefinition Height="Auto"/> <!-- 3: Gold Savings Banner -->
                <RowDefinition Height="Auto"/> <!-- 4: 24h Session Total Strip -->
                <RowDefinition Height="140"/>  <!-- 5: Real-Time Live Graph -->
                <RowDefinition Height="*"/>    <!-- 6: Hooked Apps Telemetry Log -->
                <RowDefinition Height="Auto"/> <!-- 7: Footer & Resize Hint -->
            </Grid.RowDefinitions>

            <!-- ── 0. Header Drag Bar ──────────────────────────────────────── -->
            <Grid Grid.Row="0" Margin="0,0,0,8" Background="Transparent" MouseLeftButtonDown="Header_MouseDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👑" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="HYPES TOKEN TELEMETRY"
                               Foreground="#FFD700"
                               FontWeight="Black"
                               FontSize="13"
                               FontFamily="Segoe UI, Consolas"
                               VerticalAlignment="Center"/>
                    <Border Margin="8,0,0,0"
                            Background="#2600FF88"
                            BorderBrush="#00FF88"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="5,1">
                        <TextBlock x:Name="TxtLiveBadge"
                                   Text="● LIVE"
                                   Foreground="#00FF88"
                                   FontSize="9"
                                   FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Auto-Seek AI Button -->
                    <Button x:Name="BtnSeek"
                            Content="🔍 SEEK AI"
                            Click="BtnSeek_Click"
                            Margin="0,0,4,0"
                            Padding="7,2"
                            Background="#0369A1"
                            Foreground="White"
                            BorderBrush="#38BDF8"
                            BorderThickness="1"
                            FontSize="9"
                            FontWeight="Bold"
                            ToolTip="Deep-scan system for Antigravity IDE and active AI runtimes"
                            Cursor="Hand"/>

                    <!-- Always On Top Toggle -->
                    <Button x:Name="BtnPin"
                            Content="📌 PINNED"
                            Click="BtnPin_Click"
                            Margin="0,0,4,0"
                            Padding="7,2"
                            Background="#1E1B0C"
                            Foreground="#FFD700"
                            BorderBrush="#FFD700"
                            BorderThickness="1"
                            FontSize="9"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                    <!-- Manual Test Pulse -->
                    <Button x:Name="BtnTest"
                            Content="⚡ TEST"
                            Click="BtnTest_Click"
                            Margin="0,0,4,0"
                            Padding="7,2"
                            Background="#0284C7"
                            Foreground="White"
                            BorderBrush="#38BDF8"
                            BorderThickness="1"
                            FontSize="9"
                            FontWeight="Bold"
                            Cursor="Hand"/>

                    <!-- Minimize -->
                    <Button x:Name="BtnMin"
                            Content="─"
                            Click="BtnMin_Click"
                            Margin="0,0,4,0"
                            Width="22" Height="22"
                            Background="#14FFFFFF"
                            Foreground="#CBD5E1"
                            BorderThickness="0"
                            FontSize="10"
                            Cursor="Hand"/>

                    <!-- Close -->
                    <Button x:Name="BtnClose"
                            Content="✕"
                            Click="BtnClose_Click"
                            Width="22" Height="22"
                            Background="#2A0812"
                            Foreground="#FF4D6D"
                            BorderBrush="#FF4D6D"
                            BorderThickness="1"
                            FontSize="10"
                            FontWeight="Bold"
                            Cursor="Hand"/>
                </StackPanel>
            </Grid>

            <!-- ── 1. Scrolling Ticker Marquee ─────────────────────────────── -->
            <Border Grid.Row="1"
                    Margin="0,0,0,8"
                    Background="#03060C"
                    BorderBrush="#FFD700"
                    BorderThickness="1"
                    CornerRadius="4"
                    Height="28"
                    ClipToBounds="True">
                <Canvas x:Name="TickerCanvas" Height="28">
                    <TextBlock x:Name="TxtTicker"
                               Text="🟢 HYPES TOKEN TELEMETRY ONLINE  ✦  GATEWAY: http://127.0.0.1:8000/v1  ✦  AWAITING LIVE REQUESTS  ✦  HARDWARE OPTIMIZATION ACTIVE  ✦  "
                               Foreground="#FFD700"
                               FontFamily="Consolas"
                               FontSize="11"
                               FontWeight="Bold"
                               Canvas.Top="6"
                               Canvas.Left="0"/>
                </Canvas>
            </Border>

            <!-- ── 2. The 3 Digital LCD Display Windows ────────────────────── -->
            <Grid Grid.Row="2" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Window 1: Raw Before (Amber) -->
                <Border Grid.Column="0" Margin="0,0,4,0"
                        Background="#0D0903"
                        BorderBrush="#F59E0B"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="1. RAW BEFORE"
                                   Foreground="#F59E0B"
                                   FontSize="10"
                                   FontWeight="Black"
                                   FontFamily="Segoe UI, Consolas"/>
                        <TextBlock x:Name="TxtValPre"
                                   Text="0"
                                   Foreground="#FBBF24"
                                   FontSize="26"
                                   FontWeight="Black"
                                   FontFamily="Consolas, monospace"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="Original Tokens"
                                   Foreground="#7B92AD"
                                   FontSize="9"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <!-- Window 2: Compressed Sent (Cyan) -->
                <Border Grid.Column="1" Margin="2,0,2,0"
                        Background="#030D12"
                        BorderBrush="#06B6D4"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="2. SENT AFTER"
                                   Foreground="#06B6D4"
                                   FontSize="10"
                                   FontWeight="Black"
                                   FontFamily="Segoe UI, Consolas"/>
                        <TextBlock x:Name="TxtValPost"
                                   Text="0"
                                   Foreground="#22D3EE"
                                   FontSize="26"
                                   FontWeight="Black"
                                   FontFamily="Consolas, monospace"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="M2M + ISSI Compressed"
                                   Foreground="#7B92AD"
                                   FontSize="9"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                </Border>

                <!-- Window 3: Conserved Saved (Green) -->
                <Border Grid.Column="2" Margin="4,0,0,0"
                        Background="#031208"
                        BorderBrush="#10B981"
                        BorderThickness="2"
                        CornerRadius="8"
                        Padding="10,8">
                    <StackPanel>
                        <TextBlock Text="3. CONSERVED"
                                   Foreground="#10B981"
                                   FontSize="10"
                                   FontWeight="Black"
                                   FontFamily="Segoe UI, Consolas"/>
                        <TextBlock x:Name="TxtValSaved"
                                   Text="0"
                                   Foreground="#34D399"
                                   FontSize="26"
                                   FontWeight="Black"
                                   FontFamily="Consolas, monospace"
                                   Margin="0,2,0,0"/>
                        <TextBlock Text="Tokens Saved &amp; Kept"
                                   Foreground="#7B92AD"
                                   FontSize="9"
                                   FontFamily="Consolas"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── 3. Golden Savings & Ratio Banner ────────────────────────── -->
            <Border Grid.Row="3"
                    Margin="0,0,0,8"
                    Background="{StaticResource GoldBannerBrush}"
                    BorderBrush="#D4AF37"
                    BorderThickness="2"
                    CornerRadius="8"
                    Padding="12,8">
                <Grid>
                    <TextBlock x:Name="TxtPctSaved"
                               Text="0.0% SAVINGS CONSERVED"
                               Foreground="#FFD700"
                               FontSize="17"
                               FontWeight="Black"
                               FontFamily="Segoe UI, Consolas"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtRatioBadge"
                               Text="1.0× COMPRESSION"
                               Foreground="#4ADE80"
                               FontSize="13"
                               FontWeight="Bold"
                               FontFamily="Consolas"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- ── 4. 24h Session Total Strip ──────────────────────────────── -->
            <Grid Grid.Row="4" Margin="0,0,0,8">
                <TextBlock x:Name="TxtSessionTotal"
                           Text="24h Session: 0 tokens saved (0.0% conserved · 1.0× total)"
                           Foreground="#94A3B8"
                           FontSize="10"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           VerticalAlignment="Center"/>
                <Button x:Name="BtnReset"
                        Content="↺ Reset Session"
                        Click="BtnReset_Click"
                        HorizontalAlignment="Right"
                        Padding="8,2"
                        Background="#0FFFFFFF"
                        Foreground="#CBD5E1"
                        BorderBrush="#26FFFFFF"
                        BorderThickness="1"
                        FontSize="9"
                        Cursor="Hand"/>
            </Grid>

            <!-- ── 5. Real-Time Live History Graph Canvas ─────────────────── -->
            <Grid Grid.Row="5" Margin="0,0,0,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,4">
                    <TextBlock Text="REAL-TIME LIVE TOKEN HISTORY GRAPH"
                               Foreground="#D4AF37"
                               FontSize="9"
                               FontWeight="Bold"
                               FontFamily="Consolas"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="■ RAW" Foreground="#F59E0B" FontSize="8" FontWeight="Bold" Margin="0,0,8,0" FontFamily="Consolas"/>
                        <TextBlock Text="■ SENT" Foreground="#06B6D4" FontSize="8" FontWeight="Bold" Margin="0,0,8,0" FontFamily="Consolas"/>
                        <TextBlock Text="■ SAVED" Foreground="#10B981" FontSize="8" FontWeight="Bold" FontFamily="Consolas"/>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1"
                        Background="#04070E"
                        BorderBrush="#4DD4AF37"
                        BorderThickness="1"
                        CornerRadius="6"
                        ClipToBounds="True">
                    <Canvas x:Name="GraphCanvas"
                            SizeChanged="GraphCanvas_SizeChanged"
                            Background="Transparent"/>
                </Border>
            </Grid>

            <!-- ── 6. Hooked Applications & Model Telemetry Log ────────────── -->
            <Grid Grid.Row="6" Margin="0,0,0,4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Text="HOOKED APPLICATIONS &amp; MODEL TELEMETRY LOG"
                           Foreground="#D4AF37"
                           FontSize="9"
                           FontWeight="Bold"
                           FontFamily="Consolas"
                           Margin="0,0,0,4"/>

                <Border Grid.Row="1"
                        Background="#03050A"
                        BorderBrush="#4DD4AF37"
                        BorderThickness="1"
                        CornerRadius="6">
                    <ListView x:Name="ListTelemetry"
                              Background="Transparent"
                              BorderThickness="0"
                              Foreground="#E2E8F0"
                              FontFamily="Consolas"
                              FontSize="10"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Time" Width="65" DisplayMemberBinding="{Binding Time}"/>
                                <GridViewColumn Header="App / Harness" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding App}" Foreground="#38BDF8" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Target Model" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Model}" Foreground="#C084FC" TextTrimming="CharacterEllipsis"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Raw" Width="55">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Raw}" Foreground="#FB923C"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Sent" Width="55">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Sent}" Foreground="#38BDF8"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Saved" Width="80">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Saved}" Foreground="#34D399" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>

            <!-- ── 7. Footer ───────────────────────────────────────────────── -->
            <Grid Grid.Row="7" Margin="0,4,0,0">
                <TextBlock Text="Native .NET 10 WPF · Always-on-top · Resizable · Real-time 24h ledger"
                           Foreground="#475569"
                           FontSize="8"
                           FontFamily="Consolas"/>
            </Grid>

        </Grid>
    </Border>
</Window>
